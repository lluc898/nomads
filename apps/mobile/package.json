{
  "name": "@viajeroshub/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build": "expo export --platform ios --output-dir dist",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@expo/dom-webview": "~58.0.2",
    "@viajeroshub/api-client": "workspace:*",
    "@viajeroshub/shared": "workspace:*",
    "@viajeroshub/ui": "workspace:*",
    "expo": "~58.0.19",
    "expo-constants": "~58.0.13",
    "expo-crypto": "~58.0.7",
    "expo-file-system": "~58.0.11",
    "expo-image-picker": "~58.0.10",
    "expo-linking": "~58.0.14",
    "expo-router": "~58.0.26",
    "expo-secure-store": "~58.0.2",
    "expo-status-bar": "~58.0.4",
    "expo-web-browser": "~58.0.6",
    "nativewind": "4.2.7",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "react-native-css-interop": "0.2.7",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "@types/react-dom": "19.3.0",
    "babel-preset-expo": "~58.0.20",
    "eslint": "^9.39.1",
    "eslint-config-expo": "~58.0.4",
    "tailwindcss": "~3.4.17",
